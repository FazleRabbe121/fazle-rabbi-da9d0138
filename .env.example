# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Existing Primary AI Model System Identifier (Strictly Preserved)
EXISTING_AI_SYSTEM_NAME="GEN MODEL GEN HASH 1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Optional API key for OpenAI verification in the 3-AI job application pipeline.
OPENAI_API_KEY=""

# GROK_API_KEY: Optional API key for Grok (xAI) cross-verification in the 3-AI job application pipeline.
GROK_API_KEY=""

# ============================================================================
# CAREERPILOT PERSONAL AI AGENT ENGINE (ISOLATED SELF-HOSTED CONFIGURATION)
# ============================================================================
# Activation state: Development | Testing | Ready for Review | Approved | Active | Disabled
PERSONAL_AI_ACTIVATION_STATE="Ready for Review"
AGENT_MODEL_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434/api"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_TIMEOUT_MS="90000"
OLLAMA_KEEP_ALIVE="10m"
OLLAMA_BEARER_TOKEN=""

# Scheduler & Execution Policy Bounds
AGENT_SCHEDULER_SECRET="REPLACE_WITH_RANDOM_32_BYTE_OR_LONGER_SECRET"
AGENT_AUTO_SEND_ENABLED="false"
AGENT_ALLOW_APPROVED_EMAIL_SEND="false"
AGENT_MAX_STEPS_PER_RUN="18"
AGENT_MAX_RUN_DURATION_MS="300000"
AGENT_MAX_JOBS_PER_SOURCE="250"
AGENT_MAX_SOURCES_PER_RUN="30"
AGENT_MAX_DAILY_RUNS="1"
AGENT_REQUEST_TIMEOUT_MS="20000"
AGENT_JOB_RETENTION_DAYS="180"
AGENT_AUDIT_RETENTION_DAYS="365"

# Official Public Job Board Connectors (JSON arrays)
GREENHOUSE_BOARD_TOKENS_JSON="[]"
LEVER_SITES_JSON="[]"

# Document Intelligence & PDF Engine
DOCUMENT_FONT_PATH=""
DOCUMENT_MAX_OUTPUT_BYTES="15000000"
DOCUMENT_MAX_PAGES="250"


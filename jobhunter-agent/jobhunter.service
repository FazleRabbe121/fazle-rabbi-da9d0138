# sudo cp jobhunter.service /etc/systemd/system/ && sudo systemctl enable --now jobhunter
[Unit]
Description=JobHunter agent
After=network-online.target

[Service]
WorkingDirectory=/opt/jobhunter-agent
ExecStart=/opt/jobhunter-agent/.venv/bin/python run.py
Restart=always
RestartSec=10
User=ubuntu

[Install]
WantedBy=multi-user.target

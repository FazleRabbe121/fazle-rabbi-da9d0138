# ===== Telegram (ফোন কন্ট্রোল) =====
# @BotFather থেকে নতুন বট বানিয়ে টোকেন নিন
TELEGRAM_BOT_TOKEN=
# প্রথমে খালি রেখে এজেন্ট চালান, বটকে /start দিন, সে আপনার Chat ID বলে দেবে, তারপর এখানে বসান
TELEGRAM_CHAT_ID=

# ===== Gemini (https://aistudio.google.com/apikey) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# দিনে সর্বোচ্চ কয়টি AI কল (ফ্রি লিমিট বাঁচাতে)
GEMINI_DAILY_CALLS=300

# ===== ঐচ্ছিক: Google Places (বেশি কোম্পানি পেতে) =====
GOOGLE_PLACES_API_KEY=

# ===== Gmail (App Password দিয়ে - README দেখুন) =====
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
FROM_NAME=Your Full Name

# ===== মেইল পাঠানোর নিরাপত্তা সেটিংস =====
# approve = প্রতিটা মেইল আপনি ✅ দিলে যাবে | auto = নিজে নিজে (প্রথমে approve রাখুন)
MODE=approve
DAILY_CAP=40
# নতুন অ্যাকাউন্টে ধীরে বাড়ে: প্রথম দিন WARMUP_START, প্রতিদিন +WARMUP_STEP
WARMUP_START=10
WARMUP_STEP=5
SEND_GAP_MIN=45
SEND_GAP_MAX=120
SEND_TZ=Europe/Berlin
SEND_HOUR_START=8
SEND_HOUR_END=18
FOLLOWUP_DAYS=7
# এর নিচের স্কোরে ড্রাফট বানাবে না
MIN_SCORE=45

# ===== ক্রলার =====
CRAWL_CONCURRENCY=3
CRAWL_DELAY=2.0
# JavaScript-ভারী সাইটের জন্য (pip install playwright && playwright install chromium)
USE_PLAYWRIGHT=0

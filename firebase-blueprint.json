{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information segregated by user UID",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "habitName": { "type": "string", "maxLength": 64 },
        "selectedCvId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "UserWorkspaceRecord": {
      "title": "UserWorkspaceRecord",
      "description": "Comprehensive user workspace data including CV library, applications, queue, saved jobs, and settings associated with UID",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "activeCvId": { "type": "string", "maxLength": 128 },
        "cvLibrary": { "type": "string", "maxLength": 2000000 },
        "savedJobs": { "type": "string", "maxLength": 1000000 },
        "appliedJobs": { "type": "string", "maxLength": 1000000 },
        "gmailQueue": { "type": "string", "maxLength": 1000000 },
        "employerReplies": { "type": "string", "maxLength": 500000 },
        "rejectedApplications": { "type": "string", "maxLength": 500000 },
        "jobResults": { "type": "string", "maxLength": 1000000 },
        "agentProgress": { "type": "string", "maxLength": 500000 },
        "profile": { "type": "string", "maxLength": 500000 },
        "settings": { "type": "string", "maxLength": 100000 },
        "version": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "updatedAt"]
    },
    "UserSettingsRecord": {
      "title": "UserSettingsRecord",
      "description": "User preferences and configuration settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "habitName": { "type": "string", "maxLength": 64 },
        "habitStartDate": { "type": "string", "maxLength": 64 },
        "currency": { "type": "string", "maxLength": 8 },
        "theme": { "type": "string", "maxLength": 32 },
        "autoBackup": { "type": "boolean" },
        "googleDriveConnected": { "type": "boolean" },
        "lastBackupAt": { "type": "string", "maxLength": 64 },
        "notificationsEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "BackupSnapshotRecord": {
      "title": "BackupSnapshotRecord",
      "description": "Snapshot metadata for cloud & Google Drive backup",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "itemCount": { "type": "number" },
        "snapshotData": { "type": "string", "maxLength": 500000 }
      },
      "required": ["userId", "createdAt"]
    },
    "CVUser": {
      "title": "CVUser",
      "description": "User profile authenticated with Phone Number, Name, and Reference Code",
      "type": "object",
      "properties": {
        "phoneNumber": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "referenceCode": { "type": "string", "maxLength": 64 },
        "cvData": { "type": "string", "maxLength": 500000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["phoneNumber", "name", "referenceCode"]
    },
    "CVAccountRecord": {
      "title": "CVAccountRecord",
      "description": "User account with persistent multi-CV library documents",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "passcode": { "type": "string", "maxLength": 32 },
        "phoneNumber": { "type": "string", "maxLength": 64 },
        "developerCode": { "type": "string", "maxLength": 64 },
        "cvLibrary": { "type": "string", "maxLength": 2000000 },
        "cvData": { "type": "string", "maxLength": 500000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "name"]
    },
    "InterviewAttemptRecord": {
      "title": "InterviewAttemptRecord",
      "description": "Isolated AI Interview & English Assessment attempt record segregated by user UID",
      "type": "object",
      "properties": {
        "attemptId": { "type": "string", "maxLength": 128 },
        "participantEmail": { "type": "string", "maxLength": 256 },
        "participantUid": { "type": "string", "maxLength": 128 },
        "participantName": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "maxLength": 64 },
        "level": { "type": "string", "maxLength": 16 },
        "mode": { "type": "string", "maxLength": 16 },
        "status": { "type": "string", "maxLength": 32 },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "totalScore": { "type": "number" },
        "passFailStatus": { "type": "string", "maxLength": 64 }
      },
      "required": ["attemptId", "participantEmail", "participantUid", "role", "level", "status", "startedAt"]
    }
  },
  "firestore": {
    "/cv_accounts/{accountId}": {
      "schema": "CVAccountRecord",
      "description": "Multi-CV library documents and profile keyed by normalized email"
    },
    "/cv_users/{phoneNumber}": {
      "schema": "CVUser",
      "description": "User document keyed by normalized phone number"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user profile document"
    },
    "/users/{userId}/workspace/{workspaceId}": {
      "schema": "UserWorkspaceRecord",
      "description": "User workspace state including CVs, applications, saved jobs, and queue keyed by UID"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "UserSettingsRecord",
      "description": "User configuration and preferences segregated by UID"
    },
    "/users/{userId}/backups/{backupId}": {
      "schema": "BackupSnapshotRecord",
      "description": "Backup snapshots segregated by UID"
    },
    "/users/{userId}/interviewAttempts/{attemptId}": {
      "schema": "InterviewAttemptRecord",
      "description": "Participant interview attempts and scorecards segregated by UID"
    }
  }
}

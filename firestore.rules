rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connection doc used to verify database connectivity
    match /test/connection {
      allow read: if true;
    }

    // Dynamic CV Users & Accounts (Legacy compatibility)
    match /cv_accounts/{accountId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    match /cv_users/{phoneNumber} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Strict User-Isolated Data Tree:
    // Every read and write is strictly restricted to the authenticated user matching the UID.
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // All subcollections (workspace, cvLibrary, savedJobs, applications, gmailQueue, settings, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) && isValidId(userId);
      }
    }
  }
}
